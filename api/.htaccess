# Only PHP endpoints in this folder are ever meant to be requested directly.
# Block directory listing and any stray data/config file.
Options -Indexes

<FilesMatch "\.(json|log|ini|bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
